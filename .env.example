# ══════════════════════════════════════════════════════════════
# GarbageBPFilter v3.0 配置
# 复制此文件为 .env 并填入你的 key
# ══════════════════════════════════════════════════════════════

# ── MiniMax API（必填）──
# Token Plan 订阅 key，同一把同时用于 M3 推理与 coding_plan/search 联网检索。
MINIMAX_API_KEY=your-minimax-token-plan-key

# 可选：模型名，默认 MiniMax-M3
# MINIMAX_MODEL=MiniMax-M3
# MINIMAX_MODEL_HEAVY=MiniMax-M3
# MINIMAX_MODEL_LIGHT=MiniMax-M2.7
# 国内站默认 https://api.minimaxi.com/v1（注意域名是 minimaxi）；国际站用 https://api.minimax.io/v1 覆盖。
# MINIMAX_API_HOST=https://api.minimaxi.com/v1
# 注意：联网检索走 MiniMax Token Plan 的 coding_plan/search；同花顺/天眼查等内部数据源不开放结构化直连。

# ── 后端端口，默认 3001 ──
# PORT=3001

# ── 中国镜像加速（腾讯云北京等国内服务器构建 Docker 时启用）──
# 只影响 docker build 拉依赖的速度/可达性；默认全部走官方源（海外/CI 不用改）。
# 基础镜像(node/python/nginx)另需在宿主机配 /etc/docker/daemon.json 的 registry-mirrors，见 DEPLOY.md 2.5。
# 腾讯云 CVM 推荐内网镜像（免公网流量、最快）：
# CN_MIRROR=1                                            # 启用 Debian apt 腾讯云镜像
# NPM_REGISTRY=https://registry.npmmirror.com            # npm 淘宝镜像
# PIP_INDEX=https://mirrors.tencentyun.com/pypi/simple   # pip 腾讯云内网镜像（非腾讯云改 https://pypi.tuna.tsinghua.edu.cn/simple）

# ── JWT 认证（生产环境必须修改！）──
# 生成强随机密钥：openssl rand -hex 32
# 要求：长度 ≥ 32，不得保留 "请修改" 这类占位文案，否则生产启动会被强制中止
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── 允许 /api/analyze 匿名访问（仅本地开发/演示！）──
# 仅当 NODE_ENV !== production 且此值为 1 时才生效；生产环境永远禁用。
# ALLOW_ANON_ANALYZE=0

# ── 数据库路径 ──
# DB_PATH=./data/app.db

# ── 免费额度（注册时赠送的次数）──
# DEFAULT_FREE_QUOTA=3

# ══════════════════════════════════════════════════════════════
# 企查查 Agent API（企业追踪数据源）
# 用于自动跟踪已分析企业的后续发展，验证评分预测准确性
# 不配置时追踪功能不可用，不影响核心分析功能
# ══════════════════════════════════════════════════════════════
# QCC_API_KEY=你的企查查agent_api_key

# ══════════════════════════════════════════════════════════════
# 文档提取微服务（Docker Compose 模式下自动配置）
# 不配置时使用本地 Python 子进程（fallback 模式）
# ══════════════════════════════════════════════════════════════
# DOC_SERVICE_URL=http://doc-service:8001

# PM2 本地 doc-service 监听地址（默认 127.0.0.1:8001）。
# 仅在 Docker/受控内网等需要容器或其他主机访问时设为 0.0.0.0；
# 一旦监听 0.0.0.0，必须同时配置强 DOC_SERVICE_TOKEN，并确保 8001 不对公网开放。
# DOC_SERVICE_HOST=127.0.0.1
# DOC_SERVICE_PORT=8001

# doc-service 共享密钥（生产强烈建议配置；docker-compose 会自动注入两端）
# 配置后所有 doc-service 端点要求 Bearer 认证，防止端口误暴露时被滥用
# 生成命令：openssl rand -hex 32
# DOC_SERVICE_TOKEN=

# ══════════════════════════════════════════════════════════════
# 支付网关配置（商业化后配置）
# ══════════════════════════════════════════════════════════════
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_KEY=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=

# ══════════════════════════════════════════════════════════════
# 腾讯云短信配置（验证码服务）
# ══════════════════════════════════════════════════════════════
# TENCENT_SMS_SECRET_ID=你的SecretId
# TENCENT_SMS_SECRET_KEY=你的SecretKey
# TENCENT_SMS_SDK_APP_ID=你的SdkAppId
# TENCENT_SMS_SIGN_NAME=你的短信签名
# TENCENT_SMS_TEMPLATE_ID=你的模板ID
# TENCENT_SMS_REGION=ap-guangzhou

# ══════════════════════════════════════════════════════════════
# 腾讯云 SES 邮件服务（验证码发送）
# 发信域名需在腾讯云 SES 控制台验证通过
# ══════════════════════════════════════════════════════════════
# TENCENT_SES_SECRET_ID=你的SecretId
# TENCENT_SES_SECRET_KEY=你的SecretKey
# TENCENT_SES_FROM_EMAIL=垃圾BP过滤机 <noreply@www.garbagebpfilter.cn>
# TENCENT_SES_REGION=ap-hongkong
# TENCENT_SES_TEMPLATE_ID=你的邮件模板ID（在腾讯云SES控制台创建，模板变量使用 {{code}}）

# ══════════════════════════════════════════════════════════════
# 对象存储（可选，用于 BP 文件和报告持久化）
# ══════════════════════════════════════════════════════════════
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=

# ══════════════════════════════════════════════════════════════
# 前端跨域配置（前后端分离部署时必填）
# ══════════════════════════════════════════════════════════════
# REACT_APP_API_URL=https://your-backend-domain.com

# CORS 允许的域名（逗号分隔，生产环境必须配置！不配置则拒绝所有跨域请求）
# ALLOWED_ORIGINS=https://your-frontend-domain.com,https://admin.your-domain.com

# ══════════════════════════════════════════════════════════════
# 管理员账号配置（可选，部署时设置）
# 设置后，系统启动时自动创建或升级管理员账号
# ══════════════════════════════════════════════════════════════
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_secure_password

# ══════════════════════════════════════════════════════════════
# Multiagent 投研工作台配置（Sprint 1）
# ══════════════════════════════════════════════════════════════

# 创始人姓名加密密钥（64位十六进制，即 32 字节 AES-256 密钥）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=your_64_hex_chars_here

# PII Hash 盐值（手机号/邮箱 SHA256 hash 时使用）
# 建议随机生成并保密，防止彩虹表攻击
# PII_SALT=your_random_salt_here

# 市场雷达冷启动期：数据量不足时使用公开数据 fallback
# RADAR_USE_PUBLIC_DATA_FALLBACK=true

# ══════════════════════════════════════════════════════════════
# 评分内核灰度开关（off | shadow | on，默认均为 shadow）
# ══════════════════════════════════════════════════════════════
# 三个开关相互独立。shadow=旧分仍生效、新分作对照块落库供校准；on=新分正式生效。
# 切 on 的前提：shadow 落库数据已完成校准（见 calibrationService 诊断报告）。
#
# SCORING_HARNESS=shadow      # S2 产品与壁垒 harness（TRL证据阶梯+护城河子因子）
# SCORING_S3_HARNESS=shadow   # S3 资本壁垒 harness（资本壁垒溢价/新质生产力/陡峭度/资本耐心）
# SCORING_AGG=shadow          # 投资判断内核 v3：非线性聚合(方案乙)+政策融入 S1/S3+分布/置信度
#                             # 切 on：总分算术平均→方案乙；评级走 A 级共振 gate；
#                             #        总分以分布(中位+区间+置信度)呈现；判断卡显示政策/敏感性/触发规则

# ============================================================
# 工程化修复新增配置（2026-07，全部可选，有安全默认值）
# ============================================================

# ── 全局 API 兜底限流（次/分钟/IP）。各敏感路由另有精细限流；0 = 关闭 ──
# RATE_LIMIT_GLOBAL_MAX=300

# ── 备份异地上传（P1-1）：配置后 backup 容器每日备份自动上传，未配置保持纯本地 ──
# 以腾讯云 COS 为例（rclone S3 兼容模式）；其他云参考 rclone 文档同名变量
# BACKUP_RCLONE_REMOTE=cos:your-backup-bucket/bp-backups
# RCLONE_CONFIG_COS_TYPE=s3
# RCLONE_CONFIG_COS_PROVIDER=TencentCOS
# RCLONE_CONFIG_COS_ENDPOINT=cos.ap-guangzhou.myqcloud.com
# RCLONE_CONFIG_COS_ACCESS_KEY_ID=your-secret-id
# RCLONE_CONFIG_COS_SECRET_ACCESS_KEY=your-secret-key

# ── 运行时调优参数（原先散落各模块，现统一经 server/config 读取）──
# WORKSPACE_DAILY_CHAT_LIMIT=3        # 工作区每日对话额度
# SSE_HEARTBEAT_INTERVAL=15000        # SSE 心跳间隔（毫秒）
# LIGHTWEIGHT_QUEUE_CONCURRENCY=1     # 进程内任务队列默认并发
# EVIDENCE_RAW_TEXT_MAX_CHARS=240000  # 证据库原文截断上限
# UPLOAD_EXTRACTION_CONCURRENCY=1     # 上传结构化抽取并发
# UPLOAD_STRUCTURED_EXTRACTION_DISABLED=0
# CONFLICT_JUDGE_CONCURRENCY=1
# CONFLICT_JUDGE_DISABLED=0
